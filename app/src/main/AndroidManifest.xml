<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
      Needed to enter health measurement mode; without it the vitals card reports "needs
      permission" on every metric. NOT a root permission: it carries Android's `development`
      flag, so declaring it here is enough to be granted it over adb.

          adb shell pm grant ai.nolee.demo android.permission.WRITE_SECURE_SETTINGS
    -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <queries>
        <provider android:authorities="io.kungcorp.nolee.launcher.state" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_demo"
        android:label="@string/app_name"
        android:theme="@style/Theme.NoleeCanvas">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:exported="true"
            android:keepScreenOn="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>

